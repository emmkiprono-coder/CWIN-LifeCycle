# Postgres connection (Railway provides this automatically when you attach a
# Postgres plugin to this service — copy its DATABASE_URL here for local dev)
DATABASE_URL="postgresql://user:password@localhost:5432/cwin_ops?schema=public"

# Redis connection, for BullMQ background jobs (pay runs, invoice generation,
# future Connecteam API sync). Railway's Redis plugin provides this.
REDIS_URL="redis://localhost:6379"

# Set once live Connecteam API access exists (Phase 2). Leave unset for the
# manual-import Phase 1 flow.
CONNECTEAM_API_KEY=""
CONNECTEAM_CLOCK_ID=""
